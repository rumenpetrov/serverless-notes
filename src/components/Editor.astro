---
import { getEntry } from "astro:content";
import Text from "@components/Text.astro";
import FormField from "@components/FormField.astro";
import Input from "@components/Input.astro";
import Textarea from "@components/Textarea.astro";
import Badge from "@components/Badge.astro";

interface Props {
  templateId: string;
  id?: string;
  hidden?: string;
}

const { templateId, ...rest } = Astro.props;

const entry = await getEntry("templates", templateId);
const template = entry?.data;
---

<div {...rest} class="box">
  {
    template && (
      <>
        <header class="header">
          <div class="title-row">
            <Text variant="h2">{template.title}</Text>
            <Badge variant="neutral" size="sm">v{template.version}</Badge>
          </div>

          <Text variant="p" class="description">{template.description}</Text>
        </header>

        <form id="editor-form">
          {template.content.map((field) => (
            <FormField label={field.name} htmlFor={field.name}>
              {field.type === "textarea" ? (
                <Textarea
                  name={field.name}
                  id={field.name}
                  placeholder={field.defaultValue}
                  set:text={field.defaultValue}
                />
              ) : field.type === "number" ? (
                <Input
                  type="number"
                  name={field.name}
                  id={field.name}
                  placeholder={field.defaultValue}
                  value={field.defaultValue}
                />
              ) : (
                <Input
                  type="text"
                  name={field.name}
                  id={field.name}
                  placeholder={field.defaultValue}
                  value={field.defaultValue}
                />
              )}
            </FormField>
          ))}
        </form>
      </>
    )
  }
</div>

<style>
  .box {
    padding: var(--space-5);
  }

  .header {
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .description {
    color: var(--text-muted);
  }
</style>

<script>
  import { emitEditorEvent, onEditorEvent } from "@utils/editor-events";

  const formElement = document.getElementById(
    "editor-form",
  ) as HTMLFormElement | null;

  function getFormData(): Record<string, string> {
    if (!formElement) {
      return {};
    }

    const formData = new FormData(formElement);
    const data: Record<string, string> = {};

    formData.forEach((value, key) => {
      data[key] = String(value);
    });

    return data;
  }

  function setFormData(data: Record<string, string>) {
    if (!formElement || !data) return;

    Array.from(formElement.elements).forEach((element) => {
      const input = element as HTMLInputElement | HTMLTextAreaElement;

      if (
        !(input instanceof HTMLInputElement) &&
        !(input instanceof HTMLTextAreaElement)
      ) {
        return;
      }

      const key = input.name;

      if (!key) {
        return;
      }

      if (Object.prototype.hasOwnProperty.call(data, key)) {
        input.value = data[key];
      } else {
        input.value = input.defaultValue;
      }
    });
  }

  // Handle data updates from outside
  onEditorEvent("editor:set-data", (data) => {
    setFormData(data);
  });

  // Respond to a late-registering host that missed editor:ready
  onEditorEvent("host:request-data", () => {
    emitEditorEvent("editor:ready", getFormData());
  });

  // Notify outside about changes
  formElement?.addEventListener("input", () => {
    const data = getFormData();
    emitEditorEvent("editor:change", data);
  });

  // Signal that the editor is ready and request initial data if available.
  // Fires on init; if the host registered late it will reply via
  // host:request-data, which re-fires editor:ready.
  emitEditorEvent("editor:ready", getFormData());
</script>
