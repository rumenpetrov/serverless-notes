---
type Variant =
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "p"
  | "lead"
  | "caption"
  | "muted";

interface Props {
  variant?: Variant;
  as?: any;
  class?: string;
  [key: string]: any;
}

const { variant = "p", as, class: className, ...rest } = Astro.props;

// Default HTML tags for each variant
const defaultTagMap: Record<Variant, string> = {
  h1: "h1",
  h2: "h2",
  h3: "h3",
  h4: "h4",
  h5: "h5",
  h6: "h6",
  p: "p",
  lead: "p",
  caption: "span",
  muted: "p",
};

const Tag = as ?? defaultTagMap[variant] ?? "p";
---

<Tag class:list={["text", variant, className]} {...rest}>
  <slot />
</Tag>

<style>
  .text {
    margin: 0;
    font-family: inherit;
  }

  .h1 {
    font-size: var(--font-size-8);
    font-weight: var(--font-weight-9);
    line-height: var(--font-lineheight-1);
    color: var(--text-1);
    letter-spacing: -0.02em;
  }

  .h2 {
    font-size: var(--font-size-6);
    font-weight: var(--font-weight-8);
    line-height: var(--font-lineheight-1);
    color: var(--text-1);
    letter-spacing: -0.01em;
  }

  .h3 {
    font-size: var(--font-size-5);
    font-weight: var(--font-weight-7);
    line-height: var(--font-lineheight-2);
    color: var(--text-1);
  }

  .h4 {
    font-size: var(--font-size-4);
    font-weight: var(--font-weight-7);
    line-height: var(--font-lineheight-2);
    color: var(--text-1);
  }

  .h5 {
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-6);
    line-height: var(--font-lineheight-3);
    color: var(--text-2);
  }

  .h6 {
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-6);
    line-height: var(--font-lineheight-3);
    color: var(--text-2);
  }

  .p {
    font-size: var(--font-size-2);
    font-weight: var(--font-weight-4);
    line-height: var(--font-lineheight-3);
    color: var(--text-2);
  }

  .lead {
    font-size: var(--font-size-3);
    font-weight: var(--font-weight-4);
    line-height: var(--font-lineheight-3);
    color: var(--text-1);
  }

  .caption {
    font-size: var(--font-size-0);
    font-weight: var(--font-weight-4);
    line-height: var(--font-lineheight-2);
    color: var(--text-muted);
  }

  .muted {
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-4);
    line-height: var(--font-lineheight-3);
    color: var(--text-muted);
  }
</style>
